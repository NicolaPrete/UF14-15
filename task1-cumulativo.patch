+export interface Staff {
+  id: number;
+  username: string;
+  role: UserRole;
+  isActive: boolean;
+}
+
+export interface NewStaff {
+  username: string;
+  password: string;
+  role: UserRole;
+}
+
+export interface UsernameAvailability {
